// Common Styles and Constants for Rabbit UI
// Based on old version dark theme

// Colors - Dark theme matching old version
export global Colors {
    // Primary green for buttons (matching old version)
    out property <color> primary: #7CB342;
    out property <color> primary-dark: #689F38;
    out property <color> accent: #2196F3;
    out property <color> warning: #FF9800;
    out property <color> error: #F44336;
    out property <color> success: #7CB342;

    // Dark theme backgrounds
    out property <color> background: #4A4A4A;
    out property <color> surface: #3A3A3A;
    out property <color> border: #555555;
    out property <color> divider: #555555;

    // Text colors for dark theme
    out property <color> text-primary: #FFFFFF;
    out property <color> text-secondary: #CCCCCC;
    out property <color> text-hint: #999999;

    // Status colors
    out property <color> running: #7CB342;
    out property <color> stopped: #9E9E9E;

    // Log area colors
    out property <color> log-background: #3A3A3A;
    out property <color> log-text: #FFFFFF;

    // Scan grid colors
    out property <color> scan-online: #7CB342;
    out property <color> scan-offline: #3A3A3A;
}

// Typography
export global Typography {
    out property <length> font-size-small: 11px;
    out property <length> font-size-normal: 13px;
    out property <length> font-size-medium: 14px;
    out property <length> font-size-large: 16px;
    out property <length> font-size-xlarge: 18px;

    out property <int> font-weight-normal: 400;
    out property <int> font-weight-medium: 500;
    out property <int> font-weight-bold: 600;
}

// Spacing
export global Spacing {
    out property <length> xs: 4px;
    out property <length> sm: 8px;
    out property <length> md: 12px;
    out property <length> lg: 16px;
    out property <length> xl: 24px;

    out property <length> padding-tab: 16px;
    out property <length> spacing-control: 8px;
}

// Component Sizes - Compact layout matching old version
export global Sizes {
    out property <length> button-height: 24px;
    out property <length> input-height: 24px;
    out property <length> row-height: 24px;
    out property <length> text-height: 24px;

    out property <length> log-area-height: 320px;
    out property <length> dir-list-height: 80px;
}
