// Date and Time Picker Components

import { Button, SpinBox } from "std-widgets.slint";
import { Colors, Typography, Spacing, Sizes } from "./styles.slint";

// Simple Date Picker Component (YYYY/MM/DD format)
export component DatePicker inherits Rectangle {
    in-out property <string> date: "2024/01/01";
    
    // Internal properties
    in-out property <int> year: 2024;
    in-out property <int> month: 1;
    in-out property <int> day: 1;
    
    callback date-changed(string);
    
    height: 22px;
    width: 120px;
    background: Colors.surface;
    border-color: Colors.border;
    border-width: 1px;
    border-radius: 2px;
    
    // Update date string when values change
    pure function update-date-string() -> string {
        root.year + "/" + root.month + "/" + root.day
    }
    
    // Update values when date changes
    changed date => {
        // Parse date string and update year/month/day
        // Simplified parsing - assumes format YYYY/MM/DD
    }
    
    HorizontalLayout {
        padding: 2px;
        spacing: 2px;
        
        // Year
        year-box := SpinBox {
            minimum: 2000;
            maximum: 2100;
            value <=> root.year;
            preferred-width: 50px;
            height: 18px;
        }
        
        Text {
            text: "/";
            color: Colors.text-secondary;
            font-size: 11px;
            vertical-alignment: center;
        }
        
        // Month
        month-box := SpinBox {
            minimum: 1;
            maximum: 12;
            value <=> root.month;
            preferred-width: 35px;
            height: 18px;
        }
        
        Text {
            text: "/";
            color: Colors.text-secondary;
            font-size: 11px;
            vertical-alignment: center;
        }
        
        // Day
        day-box := SpinBox {
            minimum: 1;
            maximum: 31;
            value <=> root.day;
            preferred-width: 35px;
            height: 18px;
        }
    }
    
    // Update date string when any value changes
    changed year => { root.date = root.update-date-string(); root.date-changed(root.date); }
    changed month => { root.date = root.update-date-string(); root.date-changed(root.date); }
    changed day => { root.date = root.update-date-string(); root.date-changed(root.date); }
}

// Simple Time Picker Component (HH:MM format)
export component TimePicker inherits Rectangle {
    in-out property <string> time: "12:00";
    
    // Internal properties
    in-out property <int> hour: 12;
    in-out property <int> minute: 0;
    
    callback time-changed(string);
    
    height: 22px;
    width: 80px;
    background: Colors.surface;
    border-color: Colors.border;
    border-width: 1px;
    border-radius: 2px;
    
    // Update time string when values change
    pure function update-time-string() -> string {
        // Format with leading zeros
        (root.hour < 10 ? "0" + root.hour : root.hour) + ":" + (root.minute < 10 ? "0" + root.minute : root.minute)
    }
    
    HorizontalLayout {
        padding: 2px;
        spacing: 2px;
        
        // Hour
        SpinBox {
            minimum: 0;
            maximum: 23;
            value <=> root.hour;
            preferred-width: 40px;
            height: 18px;
        }
        
        Text {
            text: ":";
            color: Colors.text-secondary;
            font-size: 11px;
            vertical-alignment: center;
        }
        
        // Minute
        SpinBox {
            minimum: 0;
            maximum: 59;
            value <=> root.minute;
            preferred-width: 40px;
            height: 18px;
        }
    }
    
    // Update time string when any value changes
    changed hour => { root.time = root.update-time-string(); root.time-changed(root.time); }
    changed minute => { root.time = root.update-time-string(); root.time-changed(root.time); }
}

// Calendar Popup Component (simplified)
export component CalendarPopup inherits Rectangle {
    in-out property <int> selected-year: 2024;
    in-out property <int> selected-month: 1;
    in-out property <int> selected-day: 1;
    
    callback date-selected(int, int, int);
    callback close();
    
    width: 200px;
    height: 220px;
    background: Colors.surface;
    border-color: Colors.border;
    border-width: 1px;
    border-radius: 4px;
    
    VerticalLayout {
        padding: 8px;
        spacing: 4px;
        
        // Header with month/year
        HorizontalLayout {
            spacing: 4px;
            
            Button {
                text: "<";
                width: 24px;
                height: 22px;
                clicked => { root.selected-month = root.selected-month > 1 ? root.selected-month - 1 : 12; }
            }
            
            Text {
                text: root.selected-year + "/" + root.selected-month;
                color: Colors.text-primary;
                font-size: 12px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            
            Button {
                text: ">";
                width: 24px;
                height: 22px;
                clicked => { root.selected-month = root.selected-month < 12 ? root.selected-month + 1 : 1; }
            }
        }
        
        // Day headers
        HorizontalLayout {
            spacing: 2px;
            for day in ["Su", "Mo", "Tu", "We", "Th", "Fr", "Sa"]: Text {
                text: day;
                width: 24px;
                height: 20px;
                color: Colors.text-secondary;
                font-size: 10px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
        
        // Calendar grid (simplified - would need proper day calculation)
        Rectangle {
            height: 120px;
            
            Text {
                text: "Calendar grid\n(31 days)";
                color: Colors.text-hint;
                font-size: 11px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
        
        // Close button
        Button {
            text: "Close";
            height: 24px;
            clicked => { root.close(); }
        }
    }
}
