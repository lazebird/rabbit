// Chat (LAN Messenger) Tab Component - Dark theme compact layout

import { Button, CheckBox, ScrollView, SpinBox, HorizontalBox, VerticalBox } from "std-widgets.slint";
import { Colors, Typography, Spacing, Sizes } from "../common/styles.slint";
import { LogArea, LineEditWithClear } from "../common/widgets.slint";

export component ChatTab inherits VerticalBox {
    callback chat-send(string);
    callback chat-toggle();
    callback chat-refresh();
    callback chat-notify();

    in-out property <string> message: "";
    in property <string> messages: "Chat messages will appear here...";
    in property <bool> enabled: false;
    in-out property <string> username: "User@PC";
    in-out property <string> broadcast-addr: "255.255.255.255";
    in-out property <int> port: 1314;
    in property <[string]> users: [];
    in property <int> selected-user: -1;

    padding: 8px;
    spacing: 4px;

    // Control Bar - compact single row
    Rectangle {
        height: 24px;

        // Label "Name"
        Text {
            x: 0;
            y: (parent.height - self.height) / 2;
            text: "Name";
            font-size: 11px;
            color: Colors.text-secondary;
            height: 20px;
            vertical-alignment: center;
        }

        // Nickname input
        LineEditWithClear {
            x: 36px;
            y: (parent.height - self.height) / 2;
            text <=> root.username;
            height: 22px;
            width: 100px;
            enabled: !root.enabled;
        }

        // Label "Port"
        Text {
            x: 144px;
            y: (parent.height - self.height) / 2;
            text: "Port";
            font-size: 11px;
            color: Colors.text-secondary;
            height: 20px;
            vertical-alignment: center;
        }

        // Port input
        SpinBox {
            x: 176px;
            y: (parent.height - self.height) / 2;
            value: root.port;
            minimum: 1;
            maximum: 65535;
            height: 22px;
            width: 70px;
            enabled: !root.enabled;
        }

        // Label "Brd"
        Text {
            x: 254px;
            y: (parent.height - self.height) / 2;
            text: "Brd";
            font-size: 11px;
            color: Colors.text-secondary;
            height: 20px;
            vertical-alignment: center;
        }

        // Broadcast input
        LineEditWithClear {
            x: 282px;
            y: (parent.height - self.height) / 2;
            text <=> root.broadcast-addr;
            height: 22px;
            width: 110px;
            enabled: !root.enabled;
        }

        // Start/Stop button
        Button {
            x: 400px;
            y: (parent.height - self.height) / 2;
            text: root.enabled ? "Stop" : "Start";
            height: 22px;
            width: 60px;
            primary: !root.enabled;

            clicked => { root.chat-toggle(); }
        }

        // Refresh button
        Button {
            x: 468px;
            y: (parent.height - self.height) / 2;
            text: "Refresh";
            enabled: root.enabled;
            height: 22px;
            width: 60px;

            clicked => { root.chat-refresh(); }
        }

        // Notify button
        Button {
            x: 536px;
            y: (parent.height - self.height) / 2;
            text: "Notify";
            enabled: root.enabled;
            height: 22px;
            width: 50px;

            clicked => { root.chat-notify(); }
        }
    }

    // Chat Area with User List
    HorizontalBox {
        spacing: 4px;
        preferred-height: 300px;

        // User List
        VerticalBox {
            width: 100px;
            spacing: 4px;

            Text {
                text: "Users";
                font-size: 11px;
                color: Colors.text-secondary;
                height: 16px;
            }

            Rectangle {
                background: Colors.surface;
                border-color: Colors.border;
                border-width: 1px;
                border-radius: 2px;

                ScrollView {
                    VerticalBox {
                        x: 4px;
                        y: 4px;
                        spacing: 2px;

                        for user in root.users: Text {
                            text: user;
                            font-size: 11px;
                            color: Colors.text-primary;
                        }

                        if root.users.length == 0: Text {
                            text: "No users";
                            font-size: 11px;
                            color: Colors.text-hint;
                        }
                    }
                }
            }
        }

        // Messages
        VerticalBox {
            preferred-width: 600px;
            spacing: 4px;

            LogArea {
                text: root.messages;
            }
        }
    }

    // Message Input
    Rectangle {
        height: 24px;

        LineEditWithClear {
            x: 0;
            y: (parent.height - self.height) / 2;
            text <=> root.message;
            height: 22px;
            width: 520px;
            enabled: root.enabled;
        }

        Button {
            x: 528px;
            y: (parent.height - self.height) / 2;
            text: "Send";
            enabled: root.enabled && root.message != "";
            height: 22px;
            width: 60px;
            primary: true;

            clicked => { root.chat-send(root.message); }
        }
    }
}
