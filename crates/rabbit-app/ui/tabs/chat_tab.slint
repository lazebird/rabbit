// Chat (LAN Messenger) Tab Component - Perfect alignment using Rectangle with manual positioning

import { Button, CheckBox, ScrollView, SpinBox, HorizontalBox, VerticalBox } from "std-widgets.slint";
import { Colors, Typography, Spacing, Sizes } from "../common/styles.slint";
import { LogArea, LineEditWithClear } from "../common/widgets.slint";

export component ChatTab inherits VerticalBox {
    callback chat-send(string);
    callback chat-toggle();
    callback chat-refresh();
    callback chat-notify();

    in-out property <string> message: "";
    in property <string> messages: "Chat messages will appear here...";
    in property <bool> enabled: false;
    in-out property <string> username: "User@PC";
    in-out property <string> broadcast-addr: "255.255.255.255";
    in-out property <int> port: 1314;
    in property <[string]> users: [];
    in property <int> selected-user: -1;

    padding: Spacing.padding-tab;
    spacing: Spacing.sm;

    // Control Bar - using Rectangle with manual y positioning
    Rectangle {
        height: Sizes.row-height;

        // Label "Name"
        Text {
            x: 0;
            y: (parent.height - self.height) / 2;
            text: "Name";
            font-size: Typography.font-size-small;
            color: Colors.text-secondary;
            height: Sizes.text-height;
            vertical-alignment: center;
        }

        // Nickname input - shows default value
        LineEditWithClear {
            x: 40px;
            y: (parent.height - self.height) / 2;
            text <=> root.username;
            preferred-width: 120px;
            height: Sizes.input-height;
            enabled: !root.enabled;
        }

        // Label "Port"
        Text {
            x: 170px;
            y: (parent.height - self.height) / 2;
            text: "Port";
            font-size: Typography.font-size-small;
            color: Colors.text-secondary;
            height: Sizes.text-height;
            vertical-alignment: center;
        }

        // Port input
        SpinBox {
            x: 204px;
            y: (parent.height - self.height) / 2;
            value: root.port;
            minimum: 1;
            maximum: 65535;
            preferred-width: 70px;
            height: Sizes.input-height;
            enabled: !root.enabled;
        }

        // Label "Brd"
        Text {
            x: 286px;
            y: (parent.height - self.height) / 2;
            text: "Brd";
            font-size: Typography.font-size-small;
            color: Colors.text-secondary;
            height: Sizes.text-height;
            vertical-alignment: center;
        }

        // Broadcast input - shows default value
        LineEditWithClear {
            x: 316px;
            y: (parent.height - self.height) / 2;
            text <=> root.broadcast-addr;
            preferred-width: 120px;
            height: Sizes.input-height;
            enabled: !root.enabled;
        }

        // Start/Stop button
        Button {
            x: 448px;
            y: (parent.height - self.height) / 2;
            text: root.enabled ? "Stop" : "Start";
            height: Sizes.button-height;
            width: 70px;
            primary: !root.enabled;

            clicked => { root.chat-toggle(); }
        }

        // Refresh button
        Button {
            x: 526px;
            y: (parent.height - self.height) / 2;
            text: "Refresh";
            enabled: root.enabled;
            height: Sizes.button-height;
            width: 60px;

            clicked => { root.chat-refresh(); }
        }

        // Notify button
        Button {
            x: 594px;
            y: (parent.height - self.height) / 2;
            text: "Notify";
            enabled: root.enabled;
            height: Sizes.button-height;
            width: 50px;

            clicked => { root.chat-notify(); }
        }
    }

    // Chat Area with User List
    HorizontalBox {
        spacing: Spacing.sm;
        preferred-height: 300px;

        // User List
        VerticalBox {
            width: 120px;
            spacing: Spacing.xs;

            Text {
                text: "Users";
                font-size: Typography.font-size-small;
                color: Colors.text-secondary;
            }

            Rectangle {
                background: Colors.surface;
                border-color: Colors.border;
                border-width: 1px;
                border-radius: 2px;

                ScrollView {
                    padding: Spacing.xs;

                    VerticalBox {
                        spacing: 2px;

                        for user in root.users: Text {
                            text: user;
                            font-size: Typography.font-size-small;
                            color: Colors.text-primary;
                        }

                        if root.users.length == 0: Text {
                            text: "No users";
                            font-size: Typography.font-size-small;
                            color: Colors.text-hint;
                        }
                    }
                }
            }
        }

        // Messages
        VerticalBox {
            preferred-width: 600px;
            spacing: Spacing.xs;

            LogArea {
                text: root.messages;
            }
        }
    }

    // Message Input
    Rectangle {
        height: Sizes.row-height;

        LineEditWithClear {
            x: 0;
            y: (parent.height - self.height) / 2;
            text <=> root.message;
            preferred-width: 600px;
            height: Sizes.input-height;
            enabled: root.enabled;
        }

        Button {
            x: 608px;
            y: (parent.height - self.height) / 2;
            text: "Send";
            enabled: root.enabled && root.message != "";
            height: Sizes.button-height;
            width: 60px;
            primary: true;

            clicked => { root.chat-send(root.message); }
        }
    }
}
