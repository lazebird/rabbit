// TFTP Client (TFTPC) Tab Component - Perfect alignment using Rectangle with manual positioning

import { Button, SpinBox, HorizontalBox, VerticalBox } from "std-widgets.slint";
import { Colors, Typography, Spacing, Sizes } from "../common/styles.slint";
import { LogArea, LineEditWithClear } from "../common/widgets.slint";

export component TftpcTab inherits VerticalBox {
    callback tftp-get();
    callback tftp-put();
    callback tftp-browse-local();

    in property <string> transfer-log: "TFTP client log will appear here...";
    in-out property <string> server-addr: "127.0.0.1";
    in-out property <int> server-port: 69;
    in-out property <string> local-path: "C:\\Users\\liulang\\Desktop\\logo.png";
    in-out property <string> remote-file: "logo.png";
    in-out property <string> client-opts: "timeout=200;retry=10;blksize=1024;";
    in property <bool> transfer-in-progress: false;

    padding: Spacing.padding-tab;
    spacing: Spacing.sm;

    // First row - Server IP, Port, Options
    Rectangle {
        height: Sizes.row-height;

        // Label "IP"
        Text {
            x: 0;
            y: (parent.height - self.height) / 2;
            text: "IP";
            font-size: Typography.font-size-small;
            color: Colors.text-secondary;
            height: Sizes.text-height;
            vertical-alignment: center;
        }

        // Server IP input - shows default value
        LineEditWithClear {
            x: 20px;
            y: (parent.height - self.height) / 2;
            text <=> root.server-addr;
            enabled: !root.transfer-in-progress;
            height: Sizes.input-height;
            width: 120px;
        }

        // Label "Port"
        Text {
            x: 150px;
            y: (parent.height - self.height) / 2;
            text: "Port";
            font-size: Typography.font-size-small;
            color: Colors.text-secondary;
            height: Sizes.text-height;
            vertical-alignment: center;
        }

        // Port input
        SpinBox {
            x: 186px;
            y: (parent.height - self.height) / 2;
            value: root.server-port;
            minimum: 1;
            maximum: 65535;
            preferred-width: 70px;
            height: Sizes.input-height;
            enabled: !root.transfer-in-progress;
        }

        // Label "Opt."
        Text {
            x: 268px;
            y: (parent.height - self.height) / 2;
            text: "Opt.";
            font-size: Typography.font-size-small;
            color: Colors.text-secondary;
            height: Sizes.text-height;
            vertical-alignment: center;
        }

        // Options input - shows default value
        LineEditWithClear {
            x: 300px;
            y: (parent.height - self.height) / 2;
            text <=> root.client-opts;
            enabled: !root.transfer-in-progress;
            height: Sizes.input-height;
            width: 240px;
        }
    }

    // Second row - Local file, Remote file, Buttons
    Rectangle {
        height: Sizes.row-height;

        // Local file input - shows default value
        LineEditWithClear {
            x: 0;
            y: (parent.height - self.height) / 2;
            text <=> root.local-path;
            enabled: !root.transfer-in-progress;
            height: Sizes.input-height;
            width: 280px;
        }

        // Browse button
        Button {
            x: 288px;
            y: (parent.height - self.height) / 2;
            text: "Browse";
            height: Sizes.button-height;
            width: 60px;

            clicked => { root.tftp-browse-local(); }
        }

        // Remote file input - shows default value
        LineEditWithClear {
            x: 360px;
            y: (parent.height - self.height) / 2;
            text <=> root.remote-file;
            enabled: !root.transfer-in-progress;
            height: Sizes.input-height;
            width: 150px;
        }

        // Put button
        Button {
            x: 520px;
            y: (parent.height - self.height) / 2;
            text: "Put";
            enabled: !root.transfer-in-progress && root.server-addr != "" && root.local-path != "" && root.remote-file != "";
            height: Sizes.button-height;
            width: 50px;
            primary: true;

            clicked => { root.tftp-put(); }
        }

        // Get button
        Button {
            x: 578px;
            y: (parent.height - self.height) / 2;
            text: "Get";
            enabled: !root.transfer-in-progress && root.server-addr != "" && root.remote-file != "";
            height: Sizes.button-height;
            width: 50px;
            primary: true;

            clicked => { root.tftp-get(); }
        }
    }

    // Transfer Log
    LogArea {
        text: root.transfer-log;
    }
}
