// Ping Tab Component - matching old version dark theme layout

import { Button, HorizontalBox, VerticalBox } from "std-widgets.slint";
import { Colors, Typography, Spacing, Sizes } from "../common/styles.slint";
import { LogArea, LineEditWithClear } from "../common/widgets.slint";

export component PingTab inherits VerticalBox {
    in-out property <string> target: "1.1.1.1";
    in-out property <string> opts: "interval=1000;count=-1;stoponloss=false";
    in property <string> results: "Ping results will appear here...";
    in property <bool> running: false;
    in property <string> stats: "";

    callback ping-start();
    callback ping-stop();

    padding: 8px;
    spacing: 4px;

    // Control Bar - compact single row
    Rectangle {
        height: 24px;

        // Label "Addr."
        Text {
            x: 0;
            y: (parent.height - self.height) / 2;
            text: "Addr.";
            font-size: 11px;
            color: Colors.text-secondary;
            height: 20px;
            vertical-alignment: center;
        }

        // Target input
        LineEditWithClear {
            x: 36px;
            y: (parent.height - self.height) / 2;
            text <=> root.target;
            enabled: !root.running;
            height: 22px;
            width: 120px;
        }

        // Label "Opt."
        Text {
            x: 164px;
            y: (parent.height - self.height) / 2;
            text: "Opt.";
            font-size: 11px;
            color: Colors.text-secondary;
            height: 20px;
            vertical-alignment: center;
        }

        // Options input
        LineEditWithClear {
            x: 192px;
            y: (parent.height - self.height) / 2;
            text <=> root.opts;
            enabled: !root.running;
            height: 22px;
            width: 320px;
        }

        // Start/Stop button - green like old version
        Button {
            x: 520px;
            y: (parent.height - self.height) / 2;
            text: root.running ? "Stop" : "Start";
            height: 22px;
            width: 60px;
            primary: true;

            clicked => {
                if (root.running) {
                    root.ping-stop();
                } else {
                    root.ping-start();
                }
            }
        }
    }

    // Statistics Bar - matching old version format
    Rectangle {
        visible: root.stats != "";
        height: 20px;
        background: Colors.surface;

        Text {
            x: 8px;
            y: (parent.height - self.height) / 2;
            text: root.stats;
            font-size: 11px;
            color: Colors.text-secondary;
            height: 16px;
            vertical-alignment: center;
        }
    }

    // Results Section - full height log area
    LogArea {
        text: root.results;
    }
}
