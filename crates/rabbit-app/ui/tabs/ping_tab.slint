// Ping Tab Component - Perfect alignment using Rectangle with manual positioning

import { Button, HorizontalBox, VerticalBox } from "std-widgets.slint";
import { Colors, Typography, Spacing, Sizes } from "../common/styles.slint";
import { LogArea, LineEditWithClear } from "../common/widgets.slint";

export component PingTab inherits VerticalBox {
    in-out property <string> target: "1.1.1.1";
    in-out property <string> opts: "interval=1000;count=-1;stoponloss=false";
    in property <string> results: "Ping results will appear here...";
    in property <bool> running: false;
    in property <string> stats: "";

    callback ping-start();
    callback ping-stop();

    padding: Spacing.padding-tab;
    spacing: Spacing.sm;

    // Control Bar - using Rectangle with manual y positioning for perfect alignment
    Rectangle {
        height: Sizes.row-height;

        // Label "Addr."
        Text {
            x: 0;
            y: (parent.height - self.height) / 2;
            text: "Addr.";
            font-size: Typography.font-size-small;
            color: Colors.text-secondary;
            height: Sizes.text-height;
            vertical-alignment: center;
        }

        // Target input - shows default value
        LineEditWithClear {
            x: 40px;
            y: (parent.height - self.height) / 2;
            text <=> root.target;
            enabled: !root.running;
            height: Sizes.input-height;
            width: 140px;
        }

        // Label "Opt."
        Text {
            x: 190px;
            y: (parent.height - self.height) / 2;
            text: "Opt.";
            font-size: Typography.font-size-small;
            color: Colors.text-secondary;
            height: Sizes.text-height;
            vertical-alignment: center;
        }

        // Options input - shows default value
        LineEditWithClear {
            x: 220px;
            y: (parent.height - self.height) / 2;
            text <=> root.opts;
            enabled: !root.running;
            height: Sizes.input-height;
            width: 280px;
        }

        // Start/Stop button
        Button {
            x: 510px;
            y: (parent.height - self.height) / 2;
            text: root.running ? "Stop" : "Start";
            height: Sizes.button-height;
            width: 70px;
            primary: true;

            clicked => {
                if (root.running) {
                    root.ping-stop();
                } else {
                    root.ping-start();
                }
            }
        }
    }

    // Statistics Bar
    Rectangle {
        visible: root.stats != "";
        height: 24px;
        background: Colors.surface;
        border-radius: 2px;

        HorizontalBox {
            spacing: Spacing.sm;
            padding-left: Spacing.xs;
            padding-right: Spacing.xs;
            alignment: center;

            Rectangle {
                width: 8px;
                height: 8px;
                border-radius: 4px;
                background: root.running ? Colors.running : Colors.stopped;
            }

            Text {
                text: root.stats;
                font-size: Typography.font-size-small;
                color: Colors.text-primary;
                vertical-alignment: center;
                height: 24px;
            }
        }
    }

    // Results Section
    LogArea {
        text: root.results;
    }
}
