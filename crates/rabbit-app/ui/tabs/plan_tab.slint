// Plan (Task Scheduler) Tab Component - Perfect alignment using Rectangle with manual positioning

import { Button, CheckBox, ComboBox, ScrollView, SpinBox, HorizontalBox, VerticalBox } from "std-widgets.slint";
import { Colors, Typography, Spacing, Sizes } from "../common/styles.slint";
import { LogArea, LineEditWithClear, IconButton } from "../common/widgets.slint";

export component PlanTab inherits VerticalBox {
    callback plan-add();
    callback plan-remove(int);
    callback plan-select(int);

    in property <string> tasks: "No tasks scheduled.";
    in property <int> task-count: 0;
    in property <int> selected-task: -1;

    in-out property <string> plan-date: "2019/6/26";
    in-out property <string> plan-time: "11:53";
    in-out property <int> plan-cycle: 0;
    in-out property <string> plan-unit: "minutes";
    in-out property <string> plan-msg: "Have a rest!";
    in-out property <bool> plan-override: false;

    padding: Spacing.padding-tab;
    spacing: Spacing.sm;

    // Control Bar - using Rectangle with manual y positioning
    Rectangle {
        height: Sizes.row-height;

        // Date input - shows default value
        LineEditWithClear {
            x: 0;
            y: (parent.height - self.height) / 2;
            text <=> root.plan-date;
            height: Sizes.input-height;
            width: 100px;
        }

        // Time input - shows default value
        LineEditWithClear {
            x: 108px;
            y: (parent.height - self.height) / 2;
            text <=> root.plan-time;
            height: Sizes.input-height;
            width: 60px;
        }

        // Repeat label
        Text {
            x: 176px;
            y: (parent.height - self.height) / 2;
            text: "Repeat /";
            font-size: Typography.font-size-small;
            color: Colors.text-secondary;
            height: Sizes.text-height;
            vertical-alignment: center;
        }

        // Cycle number
        SpinBox {
            x: 230px;
            y: (parent.height - self.height) / 2;
            value: root.plan-cycle;
            minimum: 0;
            preferred-width: 60px;
            height: Sizes.input-height;
        }

        // Unit dropdown
        ComboBox {
            x: 298px;
            y: (parent.height - self.height) / 2;
            model: ["minute", "hour", "day", "week"];
            current-index: root.plan-unit == "hours" ? 1 : root.plan-unit == "days" ? 2 : root.plan-unit == "weeks" ? 3 : 0;
            height: Sizes.input-height;
            preferred-width: 80px;

            selected => {
                root.plan-unit = self.current-index == 1 ? "hours" : self.current-index == 2 ? "days" : self.current-index == 3 ? "weeks" : "minutes";
            }
        }

        // Message input - shows default value
        LineEditWithClear {
            x: 386px;
            y: (parent.height - self.height) / 2;
            text <=> root.plan-msg;
            height: Sizes.input-height;
            width: 150px;
        }

        // Override checkbox
        CheckBox {
            x: 544px;
            y: (parent.height - self.height) / 2;
            text: "Override";
            checked: root.plan-override;
            height: Sizes.input-height;

            toggled => { root.plan-override = !root.plan-override; }
        }

        // Add button
        IconButton {
            x: 630px;
            y: (parent.height - self.height) / 2;
            icon: "+";
            primary: true;

            clicked => { root.plan-add(); }
        }

        // Remove button
        IconButton {
            x: 662px;
            y: (parent.height - self.height) / 2;
            icon: "-";
            enabled: root.selected-task >= 0;

            clicked => { root.plan-remove(root.selected-task); }
        }
    }

    // Task List
    Rectangle {
        background: Colors.surface;
        border-color: Colors.border;
        border-width: 1px;
        border-radius: 2px;

        ScrollView {
            padding: Spacing.xs;

            VerticalBox {
                spacing: 2px;

                Text {
                    text: root.tasks;
                    font-size: Typography.font-size-small;
                    color: Colors.text-primary;
                    wrap: word-wrap;
                }
            }
        }
    }
}
