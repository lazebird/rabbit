// Scan Tab Component - matching old version dark theme with IP grid

import { Button, ScrollView, HorizontalBox, VerticalBox } from "std-widgets.slint";
import { Colors, Typography, Spacing, Sizes } from "../common/styles.slint";
import { LogArea, StatusDot, LineEditWithClear } from "../common/widgets.slint";

export component ScanTab inherits VerticalBox {
    callback scan-start();
    callback scan-stop();
    callback scan-export(string);

    in property <string> results: "Scan results will appear here...";
    in property <bool> scanning: false;
    in property <int> progress: 0;
    in property <int> found: 0;
    in-out property <string> start-ip: "192.168.1.1";
    in-out property <string> end-ip: "254";
    in-out property <string> scan-opts: "filter=true";

    padding: 8px;
    spacing: 4px;

    // Control Bar - compact single row
    Rectangle {
        height: 24px;

        // Label "IP"
        Text {
            x: 0;
            y: (parent.height - self.height) / 2;
            text: "IP";
            font-size: 11px;
            color: Colors.text-secondary;
            height: 20px;
            vertical-alignment: center;
        }

        // Start IP input
        LineEditWithClear {
            x: 20px;
            y: (parent.height - self.height) / 2;
            text <=> root.start-ip;
            enabled: !root.scanning;
            height: 22px;
            width: 110px;
        }

        // Dash separator
        Text {
            x: 136px;
            y: (parent.height - self.height) / 2;
            text: "-";
            font-size: 11px;
            color: Colors.text-secondary;
            height: 20px;
            vertical-alignment: center;
        }

        // End IP input
        LineEditWithClear {
            x: 148px;
            y: (parent.height - self.height) / 2;
            text <=> root.end-ip;
            enabled: !root.scanning;
            height: 22px;
            width: 40px;
        }

        // Label "Opt."
        Text {
            x: 196px;
            y: (parent.height - self.height) / 2;
            text: "Opt.";
            font-size: 11px;
            color: Colors.text-secondary;
            height: 20px;
            vertical-alignment: center;
        }

        // Options input
        LineEditWithClear {
            x: 224px;
            y: (parent.height - self.height) / 2;
            text <=> root.scan-opts;
            enabled: !root.scanning;
            height: 22px;
            width: 200px;
        }

        // Status indicator
        Rectangle {
            x: 432px;
            y: (parent.height - self.height) / 2;
            height: 20px;
            visible: root.scanning || root.found > 0;

            StatusDot {
                x: 0;
                y: (parent.height - self.height) / 2;
                active: root.scanning;
            }

            Text {
                x: 14px;
                y: (parent.height - self.height) / 2;
                text: root.scanning
                    ? "Scanning... " + root.progress + "% (" + root.found + " found)"
                    : root.found + " hosts found";
                color: root.scanning ? Colors.running : Colors.text-secondary;
                font-size: 11px;
                height: 16px;
                vertical-alignment: center;
            }
        }

        // Start/Stop button - green
        Button {
            x: 580px;
            y: (parent.height - self.height) / 2;
            text: root.scanning ? "Stop" : "Start";
            height: 22px;
            width: 60px;
            primary: true;

            clicked => {
                if (root.scanning) {
                    root.scan-stop();
                } else {
                    root.scan-start();
                }
            }
        }
    }

    // IP Grid Display - matching old version dark theme
    Rectangle {
        background: Colors.log-background;
        border-width: 0;

        ScrollView {
            padding: 4px;

            VerticalLayout {
                alignment: start;

                Text {
                    text: root.results;
                    font-size: 12px;
                    color: Colors.log-text;
                    wrap: word-wrap;
                    font-family: "Consolas";
                    horizontal-alignment: left;
                    vertical-alignment: top;
                }
            }
        }
    }
}
