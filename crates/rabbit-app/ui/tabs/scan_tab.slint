// Scan Tab Component

import { Button, CheckBox, LineEdit, ScrollView, HorizontalBox, VerticalBox, SpinBox } from "std-widgets.slint";
import { Colors, Typography, Spacing, Sizes } from "../common/styles.slint";
import { Card, LogArea, FormRow, SectionHeader, StatusDot } from "../common/widgets.slint";

export component ScanTab inherits VerticalBox {
    callback scan-start();
    callback scan-stop();
    callback scan-export(string);

    in property <string> results: "Scan results will appear here...";
    in property <bool> scanning: false;
    in property <int> progress: 0;
    in property <int> found: 0;
    in-out property <string> start-ip: "192.168.1.1";
    in-out property <string> end-ip: "192.168.1.254";
    in-out property <bool> filter-online: true;

    padding: Spacing.padding-tab;
    spacing: Spacing.md;

    // Control Section
    Card {
        HorizontalBox {
            spacing: Spacing.md;
            alignment: start;

            // IP Range
            VerticalBox {
                spacing: Spacing.xs;

                Text {
                    text: "IP Range";
                    font-size: Typography.font-size-small;
                    color: Colors.text-secondary;
                }

                HorizontalBox {
                    spacing: Spacing.xs;

                    LineEdit {
                        placeholder-text: "Start IP";
                        text <=> root.start-ip;
                        preferred-width: 130px;
                        height: Sizes.input-height;
                        enabled: !root.scanning;
                    }

                    Text {
                        text: "-";
                        vertical-alignment: center;
                        color: Colors.text-secondary;
                    }

                    LineEdit {
                        placeholder-text: "End IP";
                        text <=> root.end-ip;
                        preferred-width: 130px;
                        height: Sizes.input-height;
                        enabled: !root.scanning;
                    }
                }
            }

            // Filter option
            VerticalBox {
                spacing: Spacing.xs;

                Text {
                    text: "Display Filter";
                    font-size: Typography.font-size-small;
                    color: Colors.text-secondary;
                }

                CheckBox {
                    text: "Online hosts only";
                    checked: root.filter-online;
                    enabled: !root.scanning;

                    toggled => { root.filter-online = !root.filter-online; }
                }
            }

            // Progress info
            VerticalBox {
                spacing: Spacing.xs;
                visible: root.scanning || root.found > 0;

                Text {
                    text: "Status";
                    font-size: Typography.font-size-small;
                    color: Colors.text-secondary;
                }

                HorizontalBox {
                    spacing: Spacing.sm;

                    StatusDot {
                        active: root.scanning;
                    }

                    Text {
                        text: root.scanning
                            ? "Scanning... " + root.progress + "% (" + root.found + " found)"
                            : root.found + " hosts found";
                        color: root.scanning ? Colors.running : Colors.text-secondary;
                        font-size: Typography.font-size-normal;
                        vertical-alignment: center;
                    }
                }
            }

            // Buttons
            HorizontalBox {
                spacing: Spacing.sm;
                alignment: end;

                Button {
                    text: root.scanning ? "Stop" : "Start Scan";
                    height: Sizes.input-height;
                    primary: !root.scanning;

                    clicked => {
                        if (root.scanning) {
                            root.scan-stop();
                        } else {
                            root.scan-start();
                        }
                    }
                }

                Button {
                    text: "Export";
                    height: Sizes.input-height;
                    enabled: !root.scanning && root.found > 0;

                    clicked => { root.scan-export("scan_results.txt"); }
                }
            }
        }
    }

    // Results Section
    VerticalBox {
        spacing: Spacing.xs;

        SectionHeader {
            text: "Scan Results";
        }

        LogArea {
            text: root.results;
        }
    }
}
