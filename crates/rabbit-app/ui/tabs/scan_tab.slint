// Scan Tab Component - Perfect alignment using Rectangle with manual positioning

import { Button, ScrollView, HorizontalBox, VerticalBox } from "std-widgets.slint";
import { Colors, Typography, Spacing, Sizes } from "../common/styles.slint";
import { LogArea, StatusDot, LineEditWithClear } from "../common/widgets.slint";

export component ScanTab inherits VerticalBox {
    callback scan-start();
    callback scan-stop();
    callback scan-export(string);

    in property <string> results: "Scan results will appear here...";
    in property <bool> scanning: false;
    in property <int> progress: 0;
    in property <int> found: 0;
    in-out property <string> start-ip: "192.168.1.1";
    in-out property <string> end-ip: "254";
    in-out property <string> scan-opts: "filter=true";

    padding: Spacing.padding-tab;
    spacing: Spacing.sm;

    // Control Bar - using Rectangle with manual y positioning
    Rectangle {
        height: Sizes.row-height;

        // Label "IP"
        Text {
            x: 0;
            y: (parent.height - self.height) / 2;
            text: "IP";
            font-size: Typography.font-size-small;
            color: Colors.text-secondary;
            height: Sizes.text-height;
            vertical-alignment: center;
        }

        // Start IP input - shows default value
        LineEditWithClear {
            x: 24px;
            y: (parent.height - self.height) / 2;
            text <=> root.start-ip;
            enabled: !root.scanning;
            height: Sizes.input-height;
            width: 120px;
        }

        // Dash separator
        Text {
            x: 150px;
            y: (parent.height - self.height) / 2;
            text: "-";
            font-size: Typography.font-size-small;
            color: Colors.text-secondary;
            height: Sizes.text-height;
            vertical-alignment: center;
        }

        // End IP input - shows default value
        LineEditWithClear {
            x: 162px;
            y: (parent.height - self.height) / 2;
            text <=> root.end-ip;
            enabled: !root.scanning;
            height: Sizes.input-height;
            width: 50px;
        }

        // Label "Opt."
        Text {
            x: 220px;
            y: (parent.height - self.height) / 2;
            text: "Opt.";
            font-size: Typography.font-size-small;
            color: Colors.text-secondary;
            height: Sizes.text-height;
            vertical-alignment: center;
        }

        // Options input - shows default value with filter parameter
        LineEditWithClear {
            x: 248px;
            y: (parent.height - self.height) / 2;
            text <=> root.scan-opts;
            enabled: !root.scanning;
            height: Sizes.input-height;
            width: 200px;
        }

        // Status indicator (visible when scanning)
        Rectangle {
            x: 460px;
            y: (parent.height - self.height) / 2;
            height: Sizes.row-height;
            visible: root.scanning || root.found > 0;

            StatusDot {
                x: 0;
                y: (parent.height - self.height) / 2;
                active: root.scanning;
            }

            Text {
                x: 16px;
                y: (parent.height - self.height) / 2;
                text: root.scanning
                    ? "Scanning... " + root.progress + "% (" + root.found + " found)"
                    : root.found + " hosts found";
                color: root.scanning ? Colors.running : Colors.text-secondary;
                font-size: Typography.font-size-small;
                height: Sizes.text-height;
                vertical-alignment: center;
            }
        }

        // Start/Stop button
        Button {
            x: 600px;
            y: (parent.height - self.height) / 2;
            text: root.scanning ? "Stop" : "Start";
            height: Sizes.button-height;
            width: 70px;
            primary: !root.scanning;

            clicked => {
                if (root.scanning) {
                    root.scan-stop();
                } else {
                    root.scan-start();
                }
            }
        }

        // Export button
        Button {
            x: 680px;
            y: (parent.height - self.height) / 2;
            text: "Export";
            height: Sizes.button-height;
            width: 60px;
            enabled: !root.scanning && root.found > 0;

            clicked => { root.scan-export("scan_results.txt"); }
        }
    }

    // IP Grid Display
    Rectangle {
        background: Colors.surface;
        border-color: Colors.border;
        border-width: 1px;
        border-radius: 2px;

        ScrollView {
            padding: Spacing.sm;

            VerticalBox {
                spacing: 2px;

                Text {
                    text: root.results;
                    font-size: Typography.font-size-small;
                    color: Colors.text-primary;
                    wrap: word-wrap;
                }
            }
        }
    }
}
