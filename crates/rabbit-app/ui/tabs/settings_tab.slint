// Settings Tab Component - Dark theme compact layout

import { Button, CheckBox, ComboBox, HorizontalBox, VerticalBox } from "std-widgets.slint";
import { Colors, Typography, Spacing, Sizes } from "../common/styles.slint";

export component SettingsTab inherits VerticalBox {
    callback settings-save();
    callback settings-reset();
    callback settings-open-home();
    callback settings-open-config();
    callback settings-open-help();
    callback settings-check-update();

    in-out property <string> language: "en";
    in-out property <string> theme: "dark";
    in-out property <bool> systray: true;
    in-out property <bool> top: false;
    in-out property <bool> autostart: false;
    in-out property <bool> autoupdate: true;
    in property <string> version: "1.0.0";

    padding: 8px;
    spacing: 4px;

    // First row - Language, Checkboxes, Links
    Rectangle {
        height: 22px;

        // Label "Language"
        Text {
            x: 0;
            y: (parent.height - self.height) / 2;
            text: "Language";
            font-size: 11px;
            color: Colors.text-secondary;
            height: 22px;
            vertical-alignment: center;
        }

        // Language dropdown
        ComboBox {
            x: 54px;
            y: (parent.height - self.height) / 2;
            model: ["English", "简体中文"];
            current-index: root.language == "zh" ? 1 : 0;
            height: 22px;
            width: 90px;

            selected => {
                root.language = self.current-index == 1 ? "zh" : "en";
            }
        }

        // Tray checkbox
        CheckBox {
            x: 154px;
            y: (parent.height - self.height) / 2;
            text: "Tray";
            checked: root.systray;
            height: 22px;

            toggled => { root.systray = !root.systray; }
        }

        // Top checkbox
        CheckBox {
            x: 220px;
            y: (parent.height - self.height) / 2;
            text: "Top";
            checked: root.top;
            height: 22px;

            toggled => { root.top = !root.top; }
        }

        // AutoStart checkbox
        CheckBox {
            x: 280px;
            y: (parent.height - self.height) / 2;
            text: "AutoStart";
            checked: root.autostart;
            height: 22px;

            toggled => { root.autostart = !root.autostart; }
        }

        // AutoUpdate checkbox
        CheckBox {
            x: 370px;
            y: (parent.height - self.height) / 2;
            text: "AutoUpdate";
            checked: root.autoupdate;
            height: 22px;

            toggled => { root.autoupdate = !root.autoupdate; }
        }

        // Home link
        Text {
            x: 480px;
            y: (parent.height - self.height) / 2;
            text: "Home";
            font-size: 11px;
            color: Colors.accent;
            height: 22px;
            vertical-alignment: center;

            TouchArea {
                clicked => { root.settings-open-home(); }
            }
        }

        // Profile link
        Text {
            x: 530px;
            y: (parent.height - self.height) / 2;
            text: "Profile";
            font-size: 11px;
            color: Colors.accent;
            height: 22px;
            vertical-alignment: center;

            TouchArea {
                clicked => { root.settings-open-config(); }
            }
        }

        // Help link
        Text {
            x: 590px;
            y: (parent.height - self.height) / 2;
            text: "Help";
            font-size: 11px;
            color: Colors.accent;
            height: 22px;
            vertical-alignment: center;

            TouchArea {
                clicked => { root.settings-open-help(); }
            }
        }
    }

    // Second row - Version info
    Rectangle {
        height: 22px;

        Text {
            x: 0;
            y: (parent.height - self.height) / 2;
            text: "Version";
            font-size: 11px;
            color: Colors.text-secondary;
            height: 22px;
            vertical-alignment: center;
        }

        Text {
            x: 50px;
            y: (parent.height - self.height) / 2;
            text: root.version;
            font-size: 11px;
            color: Colors.accent;
            height: 22px;
            vertical-alignment: center;

            TouchArea {
                clicked => { root.settings-check-update(); }
            }
        }

        Text {
            x: 100px;
            y: (parent.height - self.height) / 2;
            text: "(click to check update)";
            font-size: 11px;
            color: Colors.text-hint;
            height: 22px;
            vertical-alignment: center;
        }
    }

    // Status area
    Rectangle {
        background: Colors.surface;
        border-color: Colors.border;
        border-width: 1px;
        border-radius: 2px;
        preferred-height: 200px;

        VerticalBox {
            padding: 8px;

            Text {
                text: "Settings will be saved automatically.";
                font-size: 11px;
                color: Colors.text-secondary;
            }
        }
    }
}
