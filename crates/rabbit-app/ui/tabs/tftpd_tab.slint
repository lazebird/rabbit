// TFTP Server (TFTPD) Tab Component - Dark theme compact layout

import { Button, HorizontalBox, VerticalBox } from "std-widgets.slint";
import { Colors, Typography, Spacing, Sizes } from "../common/styles.slint";
import { LogArea, LineEditWithClear, IconButton } from "../common/widgets.slint";

export component TftpdTab inherits VerticalBox {
    callback tftp-server-toggle();
    callback tftp-add-dir();
    callback tftp-remove-dir(int);

    in property <bool> server-running: false;
    in property <string> server-log: "TFTP server log will appear here...";
    in-out property <int> server-port: 69;
    in-out property <string> server-opts: "timeout=200;retry=10;blksize=512;override=false;qsize=2000;qtout=1000;fslog=false;";
    in property <[string]> work-dirs: [];
    in-out property <int> selected-dir: -1;

    padding: 8px;
    spacing: 4px;

    // Control Bar - using Rectangle with manual y positioning
    Rectangle {
        height: 22px;

        // Add button
        IconButton {
            x: 0;
            y: (parent.height - self.height) / 2;
            icon: "+";
            enabled: !root.server-running;

            clicked => { root.tftp-add-dir(); }
        }

        // Remove button
        IconButton {
            x: 32px;
            y: (parent.height - self.height) / 2;
            icon: "-";
            enabled: !root.server-running && root.selected-dir >= 0;

            clicked => { root.tftp-remove-dir(root.selected-dir); }
        }

        // Label "Opt."
        Text {
            x: 74px;
            y: (parent.height - self.height) / 2;
            text: "Opt.";
            font-size: 11px;
            color: Colors.text-secondary;
            height: 22px;
            vertical-alignment: center;
        }

        // Options input - shows default value
        LineEditWithClear {
            x: 106px;
            y: (parent.height - self.height) / 2;
            text <=> root.server-opts;
            enabled: !root.server-running;
            height: 22px;
            width: 380px;
        }

        // Start/Stop button
        Button {
            x: 500px;
            y: (parent.height - self.height) / 2;
            text: root.server-running ? "Stop" : "Start";
            height: 22px;
            width: 70px;
            primary: true;

            clicked => { root.tftp-server-toggle(); }
        }
    }

    // Work directories list
    Rectangle {
        background: Colors.surface;
        border-color: Colors.border;
        border-width: 1px;
        border-radius: 2px;
        preferred-height: 120px;

        VerticalBox {
            padding: 4px;

            for dir[idx] in root.work-dirs: Rectangle {
                height: 22px;
                background: root.selected-dir == idx ? Colors.primary : transparent;

                HorizontalBox {
                    spacing: 4px;
                    padding: 4px;

                    Text {
                        text: dir;
                        font-size: 11px;
                        color: root.selected-dir == idx ? #FFFFFF : Colors.text-secondary;
                        overflow: elide;
                    }
                }

                TouchArea {
                    clicked => { root.selected-dir = idx; }
                }
            }

            if root.work-dirs.length == 0: Text {
                text: "No work directories added";
                font-size: 11px;
                color: Colors.text-hint;
                padding: 4px;
            }
        }
    }

    // Server Log
    LogArea {
        text: root.server-log;
    }
}
