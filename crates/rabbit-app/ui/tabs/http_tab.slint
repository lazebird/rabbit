// HTTP Server Tab Component - Perfect alignment using Rectangle with manual positioning

import { Button, CheckBox, SpinBox, HorizontalBox, VerticalBox } from "std-widgets.slint";
import { Colors, Typography, Spacing, Sizes } from "../common/styles.slint";
import { LogArea, LineEditWithClear, IconButton } from "../common/widgets.slint";

export component HttpTab inherits VerticalBox {
    callback http-toggle();
    callback http-browse();
    callback http-add-dir();
    callback http-remove-dir(int);

    in property <bool> running: false;
    in property <string> access-log: "HTTP access log will appear here...";
    in-out property <int> port: 8000;
    in-out property <string> opts: "autoindex=false;videoplay=false;shell=false;";
    in property <[string]> dirs: [];
    in-out property <int> selected-dir: -1;

    padding: Spacing.padding-tab;
    spacing: Spacing.sm;

    // Control Bar - using Rectangle with manual y positioning
    Rectangle {
        height: Sizes.row-height;

        // Label "Port"
        Text {
            x: 0;
            y: (parent.height - self.height) / 2;
            text: "Port";
            font-size: Typography.font-size-small;
            color: Colors.text-secondary;
            height: Sizes.text-height;
            vertical-alignment: center;
        }

        // Port input
        SpinBox {
            x: 36px;
            y: (parent.height - self.height) / 2;
            value: root.port;
            minimum: 1;
            maximum: 65535;
            enabled: !root.running;
            height: Sizes.input-height;
            width: 80px;
        }

        // Label "Opt."
        Text {
            x: 126px;
            y: (parent.height - self.height) / 2;
            text: "Opt.";
            font-size: Typography.font-size-small;
            color: Colors.text-secondary;
            height: Sizes.text-height;
            vertical-alignment: center;
        }

        // Options input - shows default value
        LineEditWithClear {
            x: 158px;
            y: (parent.height - self.height) / 2;
            text <=> root.opts;
            enabled: !root.running;
            height: Sizes.input-height;
            width: 280px;
        }

        // Shell checkbox
        CheckBox {
            x: 450px;
            y: (parent.height - self.height) / 2;
            text: "shell";
            checked: root.opts == "shell=true";
            enabled: !root.running;
            height: Sizes.input-height;

            toggled => {
                if (self.checked) {
                    root.opts = "shell=true";
                } else {
                    root.opts = "";
                }
            }
        }

        // Start/Stop button
        Button {
            x: 520px;
            y: (parent.height - self.height) / 2;
            text: root.running ? "Stop" : "Start";
            height: Sizes.button-height;
            width: 70px;
            primary: true;

            clicked => { root.http-toggle(); }
        }
    }

    // Directory list
    Rectangle {
        background: Colors.surface;
        border-color: Colors.border;
        border-width: 1px;
        border-radius: 2px;
        preferred-height: 120px;

        VerticalBox {
            padding: Spacing.xs;

            for dir[idx] in root.dirs: Rectangle {
                height: 24px;
                background: root.selected-dir == idx ? Colors.primary : transparent;

                HorizontalBox {
                    spacing: Spacing.xs;
                    padding: Spacing.xs;

                    Text {
                        text: dir;
                        font-size: Typography.font-size-small;
                        color: root.selected-dir == idx ? #FFFFFF : Colors.text-primary;
                        overflow: elide;
                    }
                }

                TouchArea {
                    clicked => { root.selected-dir = idx; }
                }
            }

            if root.dirs.length == 0: Text {
                text: "No directories added";
                font-size: Typography.font-size-small;
                color: Colors.text-hint;
                padding: Spacing.sm;
            }
        }
    }

    // Add/Remove buttons row
    Rectangle {
        height: 24px;

        IconButton {
            x: 0;
            y: (parent.height - self.height) / 2;
            icon: "+";
            enabled: !root.running;

            clicked => { root.http-add-dir(); }
        }

        IconButton {
            x: 32px;
            y: (parent.height - self.height) / 2;
            icon: "-";
            enabled: !root.running && root.selected-dir >= 0;

            clicked => { root.http-remove-dir(root.selected-dir); }
        }
    }

    // Access Log
    LogArea {
        text: root.access-log;
    }
}
