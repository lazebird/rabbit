// Rabbit Main Application UI
// Modular structure with separated components

import { TabWidget } from "std-widgets.slint";
import { Colors, Typography, Spacing, Sizes } from "common/styles.slint";
import { StatusBar } from "common/widgets.slint";
import { PingTab } from "tabs/ping_tab.slint";
import { ScanTab } from "tabs/scan_tab.slint";
import { HttpTab } from "tabs/http_tab.slint";
import { TftpdTab } from "tabs/tftpd_tab.slint";
import { TftpcTab } from "tabs/tftpc_tab.slint";
import { PlanTab } from "tabs/plan_tab.slint";
import { ChatTab } from "tabs/chat_tab.slint";
import { SettingsTab } from "tabs/settings_tab.slint";

// Main application window
export component AppWindow inherits Window {
    title: "Rabbit - Network Utilities";
    preferred-width: 900px;
    preferred-height: 650px;
    background: Colors.background;

    // Callbacks to be implemented in Rust
    pure callback ping_start(string, string);  // target, opts
    pure callback ping_stop();
    pure callback http_toggle(int, string, [string]);  // port, opts, dirs
    pure callback http_browse();
    pure callback http_add_dir();
    pure callback http_remove_dir(int);
    pure callback tftp_server_toggle(int, string, [string]);  // port, opts, work-dirs
    pure callback tftp_add_dir();
    pure callback tftp_remove_dir(int);
    pure callback tftp_get(string, int, string, string, string);  // server-addr, server-port, local-path, remote-file, opts
    pure callback tftp_put(string, int, string, string, string);  // server-addr, server-port, local-path, remote-file, opts
    pure callback tftp_browse_local();
    pure callback chat_send(string);
    pure callback chat_toggle(bool, string, string, int);  // enable, username, broadcast-addr, port
    pure callback chat_refresh();
    pure callback chat_notify();
    pure callback scan_start(string, string);  // start-ip, end-ip
    pure callback scan_stop();
    pure callback scan_export(string);  // filename
    pure callback plan_add(string, string, int, string, string, bool);  // date, time, cycle, unit, msg, override
    pure callback plan_remove(int);  // task-id
    pure callback plan_select(int);
    pure callback settings_save();
    pure callback settings_reset();
    pure callback settings_open_home();
    pure callback settings_open_config();
    pure callback settings_open_help();
    pure callback settings_check_update();

    // Global properties
    in-out property <string> status_text: "Ready";

    // Ping properties
    in-out property <string> ping_target: "";
    in-out property <string> ping_opts: "";
    in property <string> ping_results: "Ping results will appear here...";
    in property <bool> ping_running: false;
    in property <string> ping_stats: "";

    // HTTP properties
    in property <bool> http_running: false;
    in property <string> http_log: "HTTP access log will appear here...";
    in-out property <int> http_port: 8080;
    in-out property <string> http_opts: "";
    in property <[string]> http_dirs: [];
    in property <int> http_selected_dir: -1;

    // TFTP Server properties
    in property <bool> tftp_server_running: false;
    in property <string> tftp_server_log: "TFTP server log will appear here...";
    in-out property <int> tftp_server_port: 69;
    in-out property <string> tftp_server_opts: "";
    in property <[string]> tftp_work_dirs: [];
    in property <int> tftp_selected_dir: -1;

    // TFTP Client properties
    in property <string> tftp_client_log: "TFTP client log will appear here...";
    in-out property <string> tftp_client_server_addr: "";
    in-out property <int> tftp_client_server_port: 69;
    in-out property <string> tftp_client_local_path: "";
    in-out property <string> tftp_client_remote_file: "";
    in-out property <string> tftp_client_opts: "";
    in property <bool> tftp_transfer_in_progress: false;

    // Scan properties
    in property <string> scan_results: "Scan results will appear here...";
    in property <bool> scan_running: false;
    in property <int> scan_progress: 0;
    in property <int> scan_found: 0;
    in-out property <string> scan_start_ip: "192.168.1.1";
    in-out property <string> scan_end_ip: "254";
    in-out property <string> scan_opts: "filter=true";

    // Chat properties
    in property <string> chat_messages: "Chat messages will appear here...";
    in property <bool> chat_enabled: false;
    in-out property <string> chat_username: "";
    in-out property <string> chat_input: "";
    in-out property <string> chat_broadcast_addr: "255.255.255.255";
    in-out property <int> chat_port: 1314;
    in property <[string]> chat_users: [];
    in property <int> chat_selected_user: -1;

    // Plan properties
    in property <string> plan_tasks: "No tasks scheduled.";
    in property <int> plan_count: 0;
    in property <int> plan_selected_task: -1;
    in-out property <string> plan_date: "";
    in-out property <string> plan_time: "";
    in-out property <int> plan_cycle: 0;
    in-out property <string> plan_unit: "minutes";
    in-out property <string> plan_msg: "";
    in-out property <bool> plan_override: false;

    // Settings properties
    in-out property <string> settings_language: "en";
    in-out property <string> settings_theme: "light";
    in-out property <bool> settings_systray: true;
    in-out property <bool> settings_top: false;
    in-out property <bool> settings_autostart: false;
    in-out property <bool> settings_autoupdate: true;
    in property <string> settings_version: "1.0.0";

    VerticalLayout {
        padding: 0;

        TabWidget {
            Tab {
                title: "Ping";
                PingTab {
                    target <=> root.ping_target;
                    opts <=> root.ping_opts;
                    results: root.ping_results;
                    running: root.ping_running;
                    stats: root.ping_stats;
                    ping-start => { root.ping_start(root.ping_target, root.ping_opts); }
                    ping-stop => { root.ping_stop(); }
                }
            }
            Tab {
                title: "Scan";
                ScanTab {
                    start-ip <=> root.scan_start_ip;
                    end-ip <=> root.scan_end_ip;
                    scan-opts <=> root.scan_opts;
                    results: root.scan_results;
                    scanning: root.scan_running;
                    progress: root.scan_progress;
                    found: root.scan_found;
                    scan-start => { root.scan_start(root.scan_start_ip, root.scan_end_ip); }
                    scan-stop => { root.scan_stop(); }
                    scan-export(filename) => { root.scan_export(filename); }
                }
            }
            Tab {
                title: "HTTP";
                HttpTab {
                    running: root.http_running;
                    access-log: root.http_log;
                    port <=> root.http_port;
                    opts <=> root.http_opts;
                    dirs: root.http_dirs;
                    selected-dir: root.http_selected_dir;
                    http-toggle => { root.http_toggle(root.http_port, root.http_opts, root.http_dirs); }
                    http-browse => { root.http_browse(); }
                    http-add-dir => { root.http_add_dir(); }
                    http-remove-dir(index) => { root.http_remove_dir(index); }
                }
            }
            Tab {
                title: "TFTPD";
                TftpdTab {
                    server-running: root.tftp_server_running;
                    server-log: root.tftp_server_log;
                    server-port <=> root.tftp_server_port;
                    server-opts <=> root.tftp_server_opts;
                    work-dirs: root.tftp_work_dirs;
                    selected-dir: root.tftp_selected_dir;
                    tftp-server-toggle => { root.tftp_server_toggle(root.tftp_server_port, root.tftp_server_opts, root.tftp_work_dirs); }
                    tftp-add-dir => { root.tftp_add_dir(); }
                    tftp-remove-dir(index) => { root.tftp_remove_dir(index); }
                }
            }
            Tab {
                title: "TFTPC";
                TftpcTab {
                    transfer-log: root.tftp_client_log;
                    server-addr <=> root.tftp_client_server_addr;
                    server-port <=> root.tftp_client_server_port;
                    local-path <=> root.tftp_client_local_path;
                    remote-file <=> root.tftp_client_remote_file;
                    client-opts <=> root.tftp_client_opts;
                    transfer-in-progress: root.tftp_transfer_in_progress;
                    tftp-get => { root.tftp_get(root.tftp_client_server_addr, root.tftp_client_server_port, root.tftp_client_local_path, root.tftp_client_remote_file, root.tftp_client_opts); }
                    tftp-put => { root.tftp_put(root.tftp_client_server_addr, root.tftp_client_server_port, root.tftp_client_local_path, root.tftp_client_remote_file, root.tftp_client_opts); }
                    tftp-browse-local => { root.tftp_browse_local(); }
                }
            }
            Tab {
                title: "Plan";
                PlanTab {
                    tasks: root.plan_tasks;
                    task-count: root.plan_count;
                    selected-task: root.plan_selected_task;
                    plan-date <=> root.plan_date;
                    plan-time <=> root.plan_time;
                    plan-cycle <=> root.plan_cycle;
                    plan-unit <=> root.plan_unit;
                    plan-msg <=> root.plan_msg;
                    plan-override <=> root.plan_override;
                    plan-add => { root.plan_add(root.plan_date, root.plan_time, root.plan_cycle, root.plan_unit, root.plan_msg, root.plan_override); }
                    plan-remove(id) => { root.plan_remove(id); }
                    plan-select(id) => { root.plan_select(id); }
                }
            }
            Tab {
                title: "Chat";
                ChatTab {
                    messages: root.chat_messages;
                    enabled: root.chat_enabled;
                    username <=> root.chat_username;
                    message <=> root.chat_input;
                    broadcast-addr <=> root.chat_broadcast_addr;
                    port <=> root.chat_port;
                    users: root.chat_users;
                    selected-user: root.chat_selected_user;
                    chat-send(msg) => { root.chat_send(msg); }
                    chat-toggle => { root.chat_toggle(!root.chat_enabled, root.chat_username, root.chat_broadcast_addr, root.chat_port); }
                    chat-refresh => { root.chat_refresh(); }
                    chat-notify => { root.chat_notify(); }
                }
            }
            Tab {
                title: "Settings";
                SettingsTab {
                    language <=> root.settings_language;
                    theme <=> root.settings_theme;
                    systray <=> root.settings_systray;
                    top <=> root.settings_top;
                    autostart <=> root.settings_autostart;
                    autoupdate <=> root.settings_autoupdate;
                    version: root.settings_version;
                    settings-save => { root.settings_save(); }
                    settings-reset => { root.settings_reset(); }
                    settings-open-home => { root.settings_open_home(); }
                    settings-open-config => { root.settings_open_config(); }
                    settings-open-help => { root.settings_open_help(); }
                    settings-check-update => { root.settings_check_update(); }
                }
            }
        }

        // Status bar
        StatusBar {
            text: root.status_text;
        }
    }
}
